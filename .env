
# =========================================================
# Braba Beats — variáveis de ambiente
# Copie para .env (fora do repositório) e preencha.
# =========================================================

# ---------- Scripts de migração (migration/scripts) ----------
SOURCE_SUPABASE_URL=https://<ref-antigo>.supabase.co
SOURCE_SERVICE_ROLE_KEY=

TARGET_SUPABASE_URL=https://api.seudominio.com
TARGET_SERVICE_ROLE_KEY=

# ---------- Aplicação — servidor (nunca expostas ao navegador) ----------
SUPABASE_URL=https://api.seudominio.com
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# ---------- Aplicação — cliente (embutidas no bundle) ----------
VITE_SUPABASE_URL=https://api.seudominio.com
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ---------- E-mail transacional ----------
# O envio hoje usa o serviço do Lovable e precisa ser substituído
# por um provedor próprio (Resend, SES, Postmark ou SMTP dedicado).
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=no-reply@seudominio.com
EMAIL_SENDER_DOMAIN=seudominio.com

# ---------- SMTP do GoTrue (e-mails de autenticação) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@seudominio.com

# ---------- Supabase self-host (docker-compose) ----------
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SITE_URL=https://seudominio.com
API_EXTERNAL_URL=https://api.seudominio.com

# ---------- Google OAuth (login do admin) ----------
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=https://api.seudominio.com/auth/v1/callback
